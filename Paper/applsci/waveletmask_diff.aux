\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces LHFM architecture. Geometric-mean temporal differences from the LH, HL, and HH detail sub-bands are concatenated and processed by \texttt  {high\_freq\_conv}, consisting of a 3$\times $3 3$\to $16 convolution, LeakyReLU, a 3$\times $3 16$\to $1 convolution, and sigmoid activation. The half-resolution output $\tilde  {m}_t^{\mathrm  {local}}\in [0,1]^{1\times H/2\times W/2}$ is bilinearly upsampled before fusion.\relax }}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:lhfm}{{3}{8}{LHFM architecture. Geometric-mean temporal differences from the LH, HL, and HH detail sub-bands are concatenated and processed by \texttt {high\_freq\_conv}, consisting of a 3$\times $3 3$\to $16 convolution, LeakyReLU, a 3$\times $3 16$\to $1 convolution, and sigmoid activation. The half-resolution output $\tilde {m}_t^{\mathrm {local}}\in [0,1]^{1\times H/2\times W/2}$ is bilinearly upsampled before fusion.\relax }{figure.caption.5}{}}
\newlabel{fig:lhfm@cref}{{[figure][3][]3}{[1][7][]8}}
