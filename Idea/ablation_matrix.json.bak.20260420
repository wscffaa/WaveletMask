  "variants": [
    {
      "id": "base",
      "name": "Baseline (no masks)",
      "config": "waveletmask_base.yml",
      "role": "baseline",
      "comparison_target": null,
      "params": {"A": false, "B": false, "C": false, "fusion": "none"},
      "metrics": {"psnr_syn": 24.98, "niqe_real": 5.334}
    },
    {
      "id": "local",
      "name": "A only: Local HF Mask (direct replace)",
      "config": "waveletmask_local.yml",
      "role": "ablation",
      "comparison_target": "base",
