      "role": "ablation",
      "comparison_target": "base",
      "params": {"A": false, "B": true, "C": false, "fusion": "direct_replace"},
      "metrics": {"psnr_syn": 25.72, "niqe_real": 5.040}
    },
    {
      "id": "ab",
      "name": "A+B: max fusion",
      "config": "waveletmask_ab.yml",
      "role": "ablation",
      "comparison_target": "base",
      "params": {"A": true, "B": true, "C": false, "fusion": "max"},
      "metrics": {"psnr_syn": 25.13, "niqe_real": 5.229}
    },
    {
      "id": "local_fusion",
      "name": "A+C: Local + CNN alpha fusion",
      "config": "waveletmask_local_fusion.yml",
      "role": "ablation",
      "comparison_target": "base",
      "params": {"A": true, "B": false, "C": true, "fusion": "cnn_alpha"},
      "metrics": {"psnr_syn": 25.90, "niqe_real": 5.201}
    },
    {
      "id": "flicker_fusion",
      "name": "B+C: Flicker + CNN alpha fusion",
      "config": "waveletmask_flicker_fusion.yml",
      "role": "ablation",
      "comparison_target": "base",
      "params": {"A": false, "B": true, "C": true, "fusion": "cnn_alpha"},
      "metrics": {"psnr_syn": 25.99, "niqe_real": 5.404}
    },
    {
      "id": "full",
      "name": "Full: A+B+C with max→CNN alpha",
      "config": "waveletmask_full.yml",
      "role": "full",
      "comparison_target": "base",
      "params": {"A": true, "B": true, "C": true, "fusion": "max_then_cnn_alpha"},
      "metrics": {"psnr_syn": 26.60, "niqe_real": 4.995}
    },
    {
      "id": "gated_flicker",
      "name": "A+B+C with gated→CNN alpha fusion",
      "config": "waveletmask_gated_flicker.yml",
      "role": "ablation",
      "comparison_target": "full",
      "params": {"A": true, "B": true, "C": true, "fusion": "gated_then_cnn_alpha"},
      "metrics": {"psnr_syn": 25.87, "niqe_real": 5.332}
    },
    {
      "id": "gated_flicker_color",
      "name": "A+B+C gated with color-aware branch",
      "config": "waveletmask_gated_flicker_color.yml",
      "role": "ablation",
      "comparison_target": "gated_flicker",
      "params": {"A": true, "B": true, "C": true, "fusion": "gated_then_cnn_alpha", "color_branch": true},
      "metrics": {"psnr_syn": null, "niqe_real": null},
      "notes": "Exp-only variant (metrics TBD)"
    }
