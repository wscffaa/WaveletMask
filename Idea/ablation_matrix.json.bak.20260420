    "ab": {"A": true, "B": true, "C": false, "fusion": "max", "psnr_syn": 25.13, "niqe_real": 5.229},
    "local_fusion": {"A": true, "B": false, "C": true, "fusion": "cnn_alpha", "psnr_syn": 25.90, "niqe_real": 5.201},
    "flicker_fusion": {"A": false, "B": true, "C": true, "fusion": "cnn_alpha", "psnr_syn": 25.99, "niqe_real": 5.404},
